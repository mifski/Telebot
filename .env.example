# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram

TELEGRAM_BOT_TOKEN=your_bot_token_here

# The address the Chrome extension should talk to.
# Auto-detected on Railway / Render / Fly, so you usually don't need this.
# Set it by hand on your own VPS. Must be https:// unless it's localhost.
# PUBLIC_URL=https://your-bot.up.railway.app

# Optional - folder for user settings. Point this at a persistent volume when
# deployed (e.g. /data), or everyone's settings are wiped on each deploy.
# DATA_DIR=/data

# Optional - port for the extension API (hosts usually set this for you)
# PORT=5000
